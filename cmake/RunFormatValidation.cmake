find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
get_filename_component(tool_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(arguments --root "${FORMAT_VALIDATION_REPOSITORY_ROOT}")
if(FORMAT_VALIDATION_MODE STREQUAL "fix")
    list(APPEND arguments --fix)
elseif(NOT FORMAT_VALIDATION_MODE STREQUAL "check")
    message(FATAL_ERROR "Unknown FormatValidation mode: ${FORMAT_VALIDATION_MODE}")
endif()
if(FORMAT_VALIDATION_CLANG_FORMAT_EXECUTABLE)
    list(APPEND arguments --clang-format-executable "${FORMAT_VALIDATION_CLANG_FORMAT_EXECUTABLE}")
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${tool_root}/clang-format-validate.py" ${arguments}
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "clang-format ${FORMAT_VALIDATION_MODE} failed (${result}).")
endif()
